# Copy these nonsecret settings into the deployment environment after creating ZITADEL app.
AUTH_MODE=oidc
OIDC_ISSUER=https://YOUR-INSTANCE.zitadel.cloud
OIDC_CLIENT_ID=YOUR-PKCE-APPLICATION-ID
APP_ORIGIN=https://YOUR-DOMAIN
AUTH_OWNER_EMAIL=owner@example.org
# Configure exact callback: APP_ORIGIN/auth/callback
# No client secret: application authentication method is none (PKCE).
